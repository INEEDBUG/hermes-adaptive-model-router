# Example configuration — fully synthetic values.
# Copy to $HERMES_HOME/.env (or export the variables) and replace the placeholders.
# Never commit a real credential.

# --- routing mode -----------------------------------------------------------
# NOTE: this variable is NOT the runtime switch. The plugin resolves its mode once
# per turn from the state file ($JEV_STATE_DIR/mode.json), and a missing/corrupt
# state file resolves to `off` (fail-safe). Initialise it explicitly with:
#     python3 tools/init_state.py            # writes mode=shadow
#     python3 tools/init_state.py --mode off # disables collection
# The value below is only the default used inside router/config.py.
#
# off    : the plugin returns immediately (behaviour identical to not installed)
# shadow : decisions are recorded, the executing model never changes
# auto   : not implemented in this release — a recorded `auto` is downgraded to
#          shadow and audited as auto_not_implemented
ROUTER_MODE=shadow

# Explicit approval gate for auto mode. Leave unset/empty for shadow-only use.
# JEV_AUTO_APPROVED=yes

# --- decision thresholds ----------------------------------------------------
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.65
JEV_MIN_MARGIN=0.15
JEV_TIMEOUT_SECONDS=3

# --- credentials (placeholders only) ---------------------------------------
TYPESAFE_API_KEY=your_typesafe_key_here
# Optional overrides for a self-hosted or staged endpoint:
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- route availability -----------------------------------------------------
# Which routes this deployment has configured AND independently validated. The public
# default is empty, which means "no route is executable": the shadow record then writes
# would_execute=null instead of naming a provider. Uncomment only after that provider
# has passed its own validation matrix. Unknown names are ignored, so a future route
# needs no code change here.
# JEV_AVAILABLE_ROUTES=deepseek_flash
# JEV_AVAILABLE_ROUTES=deepseek_flash,mimo_pro
# (examples/shadow-record.example.json assumes the first of these is set.)

# --- local paths ------------------------------------------------------------
HERMES_HOME=/opt/data
# JEV_LOG_DIR=/opt/data/logs/router
# JEV_STATE_DIR=/opt/data/jev_router/state
# JEV_AUDIT_LOG=/opt/data/logs/router/mode-audit.jsonl
# JEV_ROUTER_ROOT=/opt/hermes-adaptive-model-router

# --- currently unused by the shadow release, kept for the auto design -------
# XIAOMI_API_KEY=your_xiaomi_key_here
# DEEPSEEK_API_KEY=your_deepseek_key_here
